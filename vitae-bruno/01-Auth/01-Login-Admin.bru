meta {
  name: 01 - Login Admin
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "id_usuario": "ADM-001",
    "password": "password123"
  }
}

vars:post-response {
  admin_token: res.body.data.token
}

tests {
  test("Login exitoso con 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Token devuelto", function() {
    expect(res.getBody().data.token).to.be.a('string');
  });
}
