meta {
  name: 02 - Login Medico
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "id_usuario": "MED-001",
    "password": "password123"
  }
}

vars:post-response {
  medico_token: res.body.data.token
}

tests {
  test("Login medico exitoso con 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
