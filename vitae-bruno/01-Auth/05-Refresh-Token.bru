meta {
  name: 05 - Renovar Token (Refresh)
  type: http
  seq: 5
}

post {
  url: {{base_url}}/auth/refresh
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{admin_token}}
}

vars:post-response {
  admin_token: res.body.data.token
}

tests {
  test("Refresh token exitoso retorna 200", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.token).to.be.a('string');
  });
}
