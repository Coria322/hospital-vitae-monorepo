meta {
  name: 04 - Login Recepcion
  type: http
  seq: 4
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "id_usuario": "REC-001",
    "password": "password123"
  }
}

vars:post-response {
  recepcion_token: res.body.data.token
}

tests {
  test("Login recepcion exitoso con 200 OK", function() {
    expect(res.getStatus()).to.equal(200);
  });
  test("Rol asignado es RECEPCION", function() {
    expect(res.getBody().data.usuario.rol).to.equal('RECEPCION');
  });
}
