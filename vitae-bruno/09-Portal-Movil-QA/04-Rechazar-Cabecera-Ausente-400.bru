meta {
  name: 04 - Rechazar Cabecera Ausente (400 Bad Request)
  type: http
  seq: 4
}

get {
  url: {{base_url}}/mobile/perfil
  body: none
  auth: bearer
}

auth:bearer {
  token: {{paciente_token}}
}

headers {
  Accept: application/json
}

tests {
  test("Rechaza peticiones móviles sin cabecera X-Client-Version obligatoria (RNF-006)", function() {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("CLIENT_VERSION_REQUIRED");
  });
}

