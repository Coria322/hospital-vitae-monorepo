meta {
  name: 11 - Login Admin (200 OK)
  type: http
  seq: 11
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "id_usuario": "ADM-001",
    "password": "password123"
  }
}

vars:post-response {
  admin_token: res.body.data.token
}

tests {
  test("Administrador inicia sesión exitosamente", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.usuario.rol).to.equal("ADMINISTRADOR");
  });
}

