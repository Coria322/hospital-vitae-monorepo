meta {
  name: 04 - Inconsciente Fuerza ROJO y Asigna Sala Emergencia (201 Created)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/triages
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{enfermera_token}}
}

body:json {
  {
    "id_paciente": "{{paciente_id}}",
    "presion_art": "120/80",
    "frecuencia_card": 80,
    "escala_eva": 0,
    "nivel_conciencia": "INCONSCIENTE"
  }
}

tests {
  test("Inconsciente fuerza nivel ROJO de emergencia crítica", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().data.triage.color_asig).to.equal("ROJO");
    expect(res.getBody().data.asignacion.asignado).to.equal(true);
    expect(res.getBody().data.triage.id_sala).to.be.a("string");
  });
}
