meta {
  name: 12 - Liberación de Sala o Consultorio (200 OK)
  type: http
  seq: 12
}

post {
  url: {{base_url}}/salas/CONS-01/liberar
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{medico_token}}
}

tests {
  test("Médico libera consultorio con éxito y llama al siguiente paciente", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.sala_liberada).to.equal("CONS-01");
  });
}
