meta {
  name: 09 - Consulta Cola de Urgencias Priorizada (200 OK)
  type: http
  seq: 9
}

get {
  url: {{base_url}}/triages/cola
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{medico_token}}
}

tests {
  test("Retorna cola de urgencias viva ordenada por prioridad y SLA", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data).to.be.an("array");
  });
}
