meta {
  name: 01 - Consulta de Auditoria Admin (200 OK)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/auditoria
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{admin_token}}
}

tests {
  test("Administrador puede consultar bitácora de auditoría inalterable", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.data).to.be.an("array");
  });
}
