meta {
  name: 01-Login-Admin
  type: http
  seq: 1
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "id_usuario": "ADM-001",
    "password": "password123"
  }
}

vars:post-response {
  admin_token: res.body.data.token
}

test {
  test("Administrador inicia sesión exitosamente para gestión de release", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.token).to.be.a('string');
  });
}
