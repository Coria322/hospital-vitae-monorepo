meta {
  name: 03 - Alta Medico Sin Cedula (Rechazo 422 NOM-024)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/usuarios
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{admin_token}}
}

body:json {
  {
    "id_usuario": "MED-NOCED",
    "nombre_completo": "Dr. Sin Cedula",
    "rol": "MEDICO",
    "cedula": null,
    "password": "password123"
  }
}

tests {
  test("Alta de medico sin cedula rechazada con 422", function() {
    expect(res.getStatus()).to.equal(422);
  });
}
