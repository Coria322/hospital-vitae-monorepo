meta {
  name: 07 - Rechazar Modificación de Nota Cerrada (405 Method Not Allowed)
  type: http
  seq: 7
}

put {
  url: {{base_url}}/expedientes-clinicos/{{expediente_id}}/notas/{{nota_id}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{medico_token}}
}

body:json {
  {
    "contenido": "Intento no autorizado de modificación de nota médica sellada."
  }
}

tests {
  test("Bloquea modificación física de notas médicas con HTTP 405 conforme a NOM-004", function() {
    expect(res.getStatus()).to.equal(405);
    expect(res.getBody().status).to.equal("error");
    expect(res.getBody().code).to.equal("METODO_NO_PERMITIDO");
  });
}
