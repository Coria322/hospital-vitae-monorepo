meta {
  name: 24 - Rechazar Acceso Sin Relación Asistencial (403 Forbidden)
  type: http
  seq: 24
}

get {
  url: {{base_url}}/expedientes-clinicos/{{expediente_id}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{medico2_token}}
}

tests {
  test("Rechaza consulta con 403 y sugiere Break-the-Glass por falta de relación asistencial", function() {
    expect(res.getStatus()).to.equal(403);
    expect(res.getBody().status).to.equal("error");
    expect(res.getBody().code).to.equal("BREAK_THE_GLASS_REQUIRED");
  });
}
