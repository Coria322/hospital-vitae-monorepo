meta {
  name: 03 - Crear Expediente Clínico Válido (201 Created)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/expedientes-clinicos
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Authorization: Bearer {{medico_token}}
}

body:json {
  {
    "id_paciente": "{{paciente_id}}",
    "motivo_consulta": "Evaluación integral por dolor torácico opresivo de 2 horas de evolución.",
    "diagnostico": "Síndrome coronario agudo sin elevación del ST en estudio.",
    "estudios_previos": "Electrocardiograma de 12 derivaciones en sala de urgencias."
  }
}

vars:post-response {
  expediente_id: res.body.data.id_expediente
}

tests {
  test("Expediente clínico aperturado conforme a NOM-004-SSA3-2012", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().status).to.equal("success");
    expect(res.getBody().data.id_expediente).to.be.a('string');
    expect(res.getBody().data.estado_activo).to.equal(true);
  });
}
